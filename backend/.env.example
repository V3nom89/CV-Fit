# CVFit Backend — Variabili d'ambiente
# Copia questo file in .env e compila i valori

# Server
PORT=3000
NODE_ENV=development

# Database (Supabase — copia la connection string dal dashboard)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# JWT
JWT_SECRET=metti_qui_una_stringa_lunga_e_random_almeno_32_caratteri

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-api03-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_JOBSEEKER=price_...   # Crea in Stripe Dashboard: €9/mese
STRIPE_PRICE_PRO=price_...         # Crea in Stripe Dashboard: €19/mese

# URLs
FRONTEND_URL=http://localhost:3000
